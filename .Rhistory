import seaborn as sns
import matplotlib.pyplot as plt
import pandas as pd
import umap.umap_ as umap
# Thiet lap style
sns.set(style='whitegrid')
# Bo cot Cluster va giam chieu
features = non_outliers_df.drop("Cluster", axis=1)
reducer = umap.UMAP(random_state=42)
embedding = reducer.fit_transform(features)
# DataFrame cho truc quan hoa
umap_df = pd.DataFrame(embedding, columns=["UMAP1", "UMAP2"])
umap_df["Cluster"] = non_outliers_df["Cluster"].astype(str)
# Tao bang mau dong nhat voi cum truoc
cluster_palette = {
'0': '#1f77b4',  # xanh
'1': '#2ca02c',  # cam
'2': '#d62728',  # xanh la
}
# Ve scatter plot
_=plt.figure(figsize=(4, 2.8))
_=sns.scatterplot(
data=umap_df,
x="UMAP1",
y="UMAP2",
hue="Cluster",
palette=cluster_palette,
alpha=0.8,
s=60,
edgecolor='w',
linewidth=0.3
)
_=plt.title("UMAP Projection of Customer Segments", fontsize=14, pad=10)
_=plt.xlabel("UMAP 1")
_=plt.ylabel("UMAP 2")
_=plt.legend(title="Cluster", loc='best')
plt.grid(True)
plt.tight_layout()
plt.show()
plt.close()
